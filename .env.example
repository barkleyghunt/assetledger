# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres (set by `neon init` / `neon env pull`)
DATABASE_URL=

# Neon Auth (from the Better Auth page in the Neon console)
NEON_AUTH_BASE_URL=
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Comma-separated emails allowed to create an account, e.g. you@example.com,consultant@example.com
ALLOWED_SIGNUP_EMAILS=
