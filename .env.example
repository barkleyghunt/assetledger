# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres (set by `neon init` / `neon env pull`)
DATABASE_URL=

# Neon Auth (from the Better Auth page in the Neon console)
NEON_AUTH_BASE_URL=
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Comma-separated emails allowed to create an account, e.g. you@example.com,consultant@example.com
ALLOWED_SIGNUP_EMAILS=

# Cloudflare R2 for scan and photo files (R2 > Manage API tokens, Object Read & Write on this bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=assetledger-scans
